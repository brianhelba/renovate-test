{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  // EXPERIMENT 6: rangeStrategy "pin"
  // Hypotheses:
  //   - "pin" converts all ranges to exact versions: >=7 -> ==X.Y.Z, >=4.2,<5 -> ==4.2.Z
  //   - "pin" also pins requires-python (like bump), so the guard rule is still needed
  //   - ==X.Y.Z pins are updated normally (same as bump)
  //   - bare dep "httpx" is still invisible (no version to pin)
  //   - This strategy is better for projects + templates (enforces == everywhere)
  "rangeStrategy": "pin",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      // Guard rule: prevent pinning requires-python
      "matchDepNames": ["python"],
      "matchManagers": ["pep621"],
      "enabled": false
    },
    {
      "matchManagers": ["pyenv"],
      "groupSlug": "python-version",
      "groupName": ".python-version",
      "versioning": "docker"
    }
  ]
}
